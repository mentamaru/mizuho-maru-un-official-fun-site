    "typecheck": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "collect:official": "tsx scripts/collect-official.ts",
    "verify:official-changes": "tsx scripts/verify-official-changes.ts",
    "collect:radar": "tsx scripts/collect-radar.ts",
    "verify:radar-changes": "tsx scripts/verify-radar-changes.ts",
    "collect:social-og": "tsx scripts/collect-social-og.ts"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "repository": {
    "type": "git",
