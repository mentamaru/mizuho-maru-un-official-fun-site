# v1のsummarize (scripts/summarize.ts) は外部AI Providerを呼び出さず、
# Deterministic(規則ベース)な要約のみを生成する。
# 以下は将来 外部AI Providerへ接続する場合のためのPlaceholderであり、
# v1のコードからは参照されない。
AI_API_KEY=
AI_MODEL=
# 未設定または "deterministic" 以外の値はdeterministic要約へFallbackする。
SUMMARY_PROVIDER=

# みずほまるレーダー用。ローカルで `npm run collect:radar` を実行する場合のみ設定する。
OPENAI_API_KEY=
# 空欄時は gpt-5。Projectで許可されたWeb Search対応モデルを指定して上書きできる。
OPENAI_RADAR_MODEL=
