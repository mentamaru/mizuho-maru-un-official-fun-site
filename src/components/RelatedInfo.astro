---
import { formatDate, getSourceTypeLabel, type PortalItem } from '../lib/site-data';
import { toAbsoluteHttpUrl } from '../lib/url';

interface Props {
  groups: Record<string, PortalItem[]>;
}

const { groups } = Astro.props;
const safeGroups = Object.fromEntries(
  Object.entries(groups).map(([source, items]) => [
    source,
    items.map((item) => ({
      ...item,
      safeOriginalUrl: toAbsoluteHttpUrl(item.originalUrl)
    }))
  ])
);
---

<section class="space-y-6">
  <div>
    <p class="text-sm font-semibold text-primary">元情報一覧</p>
    <h2 class="text-2xl font-bold text-base-content">関連情報</h2>
  </div>

  <div class="grid gap-6 xl:grid-cols-2">
    {Object.entries(safeGroups).map(([source, items]) => (
      <section class="rounded-3xl border border-secondary/40 bg-base-100 p-5 shadow-sm">
        <h3 class="text-lg font-bold text-base-content">{source}</h3>
        <ul class="mt-4 space-y-4">
          {items.map((item) => (
            <li class="rounded-2xl border border-base-300/70 bg-base-100 p-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="badge badge-outline border-primary/30 text-primary">{getSourceTypeLabel(item.sourceType)}</span>
                <span class="text-sm text-base-content/70">{formatDate(item.publishedAt, item.collectedAt)}</span>
              </div>
              <h4 class="mt-2 font-semibold text-base-content">{item.title}</h4>
              <p class="mt-1 text-sm text-base-content/70">{item.category}</p>
              <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm">
                <span class="text-base-content/60">必要最小限のメタデータのみ掲載</span>
                {item.safeOriginalUrl ? (
                  <a class="link link-hover text-primary" href={item.safeOriginalUrl} rel="noreferrer" target="_blank">元ページを開く</a>
                ) : (
                  <span class="text-base-content/60">元ページ URL を確認中です</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>
