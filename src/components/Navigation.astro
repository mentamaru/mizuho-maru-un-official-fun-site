---
import { navigationTabs } from '../lib/content';
const isHome = Astro.url.pathname === '/';
---

<nav
  aria-label="メインナビゲーション"
  role={isHome ? "tablist" : undefined}
  class="main-navigation"
>
  {navigationTabs.map((tab, index) => (
    isHome ? <button
      type="button"
      role="tab"
      class:list={['main-navigation-item', index === 0 && 'tab-active']}
      id={`${tab.id}-tab`}
      data-tab-trigger
      data-target={tab.id}
      aria-controls={`${tab.id}-panel`}
      aria-selected={index === 0 ? 'true' : 'false'}
      tabindex={index === 0 ? '0' : '-1'}
    >
      {tab.label}
    </button> : <a class="main-navigation-item" href={`/#${tab.id}`}>{tab.label}</a>
  ))}
</nav>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-tab-panel]'));

  if (triggers.length > 0 && panels.length > 0) {
    document.documentElement.dataset.tabsReady = 'true';

    const setActiveTab = (targetId: string, options: { moveFocus?: boolean } = {}) => {
      triggers.forEach((trigger) => {
        const active = trigger.dataset.target === targetId;
        trigger.classList.toggle('tab-active', active);
        trigger.setAttribute('aria-selected', String(active));
        trigger.setAttribute('tabindex', active ? '0' : '-1');
        if (active) {
          if (options.moveFocus) trigger.focus({ preventScroll: true });
          // Reveal only within the horizontal navigation; never scroll the page vertically.
          const navigation = trigger.parentElement;
          if (navigation) {
            const item = trigger.getBoundingClientRect();
            const viewport = navigation.getBoundingClientRect();
            if (item.left < viewport.left) navigation.scrollLeft += item.left - viewport.left;
            else if (item.right > viewport.right) navigation.scrollLeft += item.right - viewport.right;
          }
        }
      });

      panels.forEach((panel) => {
        panel.hidden = panel.id !== `${targetId}-panel`;
      });
      window.dispatchEvent(new CustomEvent('site-tabchange', { detail: { targetId } }));
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        setActiveTab(trigger.dataset.target ?? 'latest');
        history.replaceState(null, '', `#${trigger.dataset.target}`);
      });
      trigger.addEventListener('keydown', (event) => {
        if (!(event instanceof KeyboardEvent)) {
          return;
        }

        const currentIndex = triggers.indexOf(trigger);
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          const next = triggers[(currentIndex + 1) % triggers.length];
          setActiveTab(next.dataset.target ?? 'latest', { moveFocus: true });
          return;
        }

        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          const previous = triggers[(currentIndex - 1 + triggers.length) % triggers.length];
          setActiveTab(previous.dataset.target ?? 'latest', { moveFocus: true });
        }
      });
    });

    const openHash = () => setActiveTab(triggers.some(t => t.dataset.target === location.hash.slice(1)) ? location.hash.slice(1) : 'latest');
    window.addEventListener('hashchange', openHash);
    openHash();
  }
</script>
