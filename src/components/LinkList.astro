---
interface LinkEntry {
  id: string;
  title: string;
  url: string;
  description: string;
  category: string;
}

interface Props {
  groups: Record<string, LinkEntry[]>;
  heading?: string;
}

const { groups, heading = 'リンク集' } = Astro.props;
---

<section class="space-y-6">
  <h2 class="text-2xl font-bold text-base-content">{heading}</h2>

  <div class="space-y-8">
    {Object.entries(groups).map(([category, entries]) => (
      <section>
        <h3 class="text-sm font-semibold text-base-content/70">{category}</h3>
        <ul class="official-links mt-2">
          {entries.map((entry) => (
            <li>
              <a class="official-link" href={entry.url} rel="noopener noreferrer" target="_blank">
                <span class="official-link-title">{entry.title}</span>
                <span class="official-link-description">{entry.description}</span>
                <svg class="official-link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
                  <path d="M14 4h6v6M20 4l-9 9M10 4H4v16h16v-6" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>
