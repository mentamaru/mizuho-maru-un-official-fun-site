---
import type { RadarItem } from '../lib/radar';
import { toAbsoluteHttpUrl } from '../lib/url';
interface Props { items: RadarItem[]; }
const { items } = Astro.props;
const format = (value: string) => new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', month: 'numeric', day: 'numeric' }).format(new Date(value));
---
<section class="space-y-5" aria-labelledby="radar-heading">
  <div class="space-y-2"><h2 id="radar-heading" class="text-2xl font-bold">みずほまるレーダー</h2><p class="leading-7 text-base-content/80">AIがWeb上を定期的に調査し、みずほまるに関する新しい話題を紹介しています。内容はAIによる要約です。詳しくは元情報をご確認ください。</p></div>
  {items.length > 0 ? <><div class="grid gap-4 lg:grid-cols-3">{items.map(item => <article class="card border border-secondary/40 bg-base-100 shadow-sm"><div class="card-body gap-3"><div class="flex flex-wrap gap-2"><span class="badge badge-outline border-primary/30 text-primary">レーダー</span><span class="text-sm text-base-content/70">{format(item.discoveredAt)} 発見</span></div><h3 class="text-lg font-bold leading-7">{item.title}</h3>{item.date && <p class="text-sm text-base-content/70">{item.dateType === 'event' ? '開催日' : item.dateType === 'sale' ? '発売日' : item.dateType === 'broadcast' ? '放送日' : '日付'}：{item.date}</p>}<p class="leading-7 text-base-content/80">{item.summary}</p><a class="btn btn-primary btn-sm" href={toAbsoluteHttpUrl(item.source.url) ?? undefined} target="_blank" rel="noreferrer">元情報を見る</a></div></article>)}</div><a class="link font-semibold text-primary" href="/radar/">レーダー一覧を見る</a></> : <p class="text-base-content/70">現在、掲載できるレーダー情報はありません。</p>}
</section>
