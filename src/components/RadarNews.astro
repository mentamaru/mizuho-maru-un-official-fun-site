---
import RadarMetadata from './RadarMetadata.astro';
import type { RadarItem } from '../lib/radar';
import { toAbsoluteHttpUrl } from '../lib/url';
interface Props { items: RadarItem[]; }
const { items } = Astro.props;
---
<section class="space-y-5" aria-labelledby="radar-heading">
  <div class="space-y-2"><h2 id="radar-heading" class="text-2xl font-bold">みずほまるレーダー</h2><p class="leading-7 text-base-content/80">AIがWeb上を定期的に調査し、みずほまるに関する新しい話題を紹介しています。内容はAIによる要約です。詳しくは元情報をご確認ください。</p></div>
  {items.length > 0 ? <><div class="news-grid">{items.map(item => <article class="news-article">{item.thumbnailUrl && <img data-radar-thumbnail src={item.thumbnailUrl} alt="" loading="lazy" class="aspect-[1.91/1] w-full object-cover" />}<div class="news-body"><h3 class="text-lg font-bold leading-7">{item.title}</h3><RadarMetadata item={item} /><p class="leading-7 text-base-content/80">{item.summary}</p><a class="news-source-link" href={toAbsoluteHttpUrl(item.source.url) ?? undefined} target="_blank" rel="noreferrer">元情報を見る</a></div></article>)}</div><a class="link font-semibold text-primary" href="/radar/">レーダー一覧を見る</a></> : <p class="text-base-content/70">現在、掲載できるレーダー情報はありません。</p>}
</section>
