---
import Navigation from './Navigation.astro';
import { siteCopy } from '../lib/content';
const TitleTag = Astro.url.pathname === '/' ? 'h1' : 'p';
---

<header class="border-b border-secondary/40 bg-base-100">
  <div class="mx-auto flex w-full min-w-0 max-w-6xl flex-col gap-3 px-4 pt-4 pb-2 sm:px-6 sm:pt-5 lg:px-8">
    <TitleTag class="text-balance text-xl leading-relaxed font-bold tracking-tight text-base-content sm:text-2xl">
      <a href="/" class="hover:text-primary">{siteCopy.siteTitle}</a>
    </TitleTag>
    <Navigation />
  </div>
</header>
