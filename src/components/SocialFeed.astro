---
import { siteCopy, socialPlatforms } from '../lib/content';
import { getEmbedScriptUrl, type SocialEntry } from '../lib/social';

interface Props {
  groups: Record<'x' | 'instagram', SocialEntry[]>;
}

const { groups } = Astro.props;
---

<section class="space-y-6">
  <div class="space-y-2">
    <p class="text-sm font-semibold text-primary">Whitelist / Lazy Load</p>
    <h2 class="text-2xl font-bold text-base-content">関連SNS</h2>
    <p class="max-w-3xl text-sm leading-7 text-base-content/80">{siteCopy.socialDisclaimer}</p>
  </div>

  <div
    role="tablist"
    class="tabs tabs-boxed grid grid-cols-2 gap-2 rounded-3xl border border-secondary/50 bg-base-100 p-2 shadow-sm"
  >
    {socialPlatforms.map((platform, index) => (
      <button
        type="button"
        role="tab"
        class:list={['tab rounded-2xl px-4 py-3 font-semibold', index === 0 && 'tab-active']}
        id={`${platform.id}-social-tab`}
        data-social-trigger
        data-platform={platform.id}
        aria-controls={`${platform.id}-social-panel`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? '0' : '-1'}
      >
        {platform.label}
      </button>
    ))}
  </div>

  {socialPlatforms.map((platform, index) => (
    <section
      id={`${platform.id}-social-panel`}
      data-social-panel
      role="tabpanel"
      aria-labelledby={`${platform.id}-social-tab`}
      hidden={index !== 0}
      class="space-y-4"
    >
      {groups[platform.id].length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2">
          {groups[platform.id].map((entry) => (
            <article class="card border border-secondary/40 bg-base-100 shadow-sm">
              <div class="card-body gap-4">
                <div class="space-y-1">
                  <p class="text-sm font-semibold text-primary">{entry.category}</p>
                  <h3 class="text-lg font-bold text-base-content">{entry.displayName}</h3>
                  <p class="break-all text-sm text-base-content/70">@{entry.accountId}</p>
                </div>
                <p class="text-sm leading-7 text-base-content/80">
                  必要な外部リソースは利用時まで読み込みません。X はタイムラインを遅延読み込みし、表示できない場合は外部プロフィールへ移動できます。
                </p>
                <div class="flex flex-wrap gap-3">
                  {entry.platform === 'x' ? (
                    <button
                      type="button"
                      class="btn btn-primary btn-sm"
                      data-social-load
                      data-platform={entry.platform}
                      data-script={getEmbedScriptUrl(entry.platform)}
                      data-status-id={`${entry.id}-status`}
                      data-target-id={`${entry.id}-embed`}
                      data-profile-url={entry.profileUrl}
                      data-display-name={entry.displayName}
                    >
                      X タイムラインを読み込む
                    </button>
                  ) : null}
                  <a class="btn btn-outline btn-sm border-primary/40 text-primary" href={entry.profileUrl} rel="noreferrer" target="_blank">外部プロフィール</a>
                </div>
                <p id={`${entry.id}-status`} class="text-sm text-base-content/70">
                  {entry.platform === 'x' ? '未読み込み' : '外部プロフィールから確認できます。'}
                </p>
                {entry.platform === 'x' ? <div id={`${entry.id}-embed`} class="overflow-hidden rounded-2xl" /> : null}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-3xl border border-dashed border-secondary/50 bg-base-100 p-6 text-sm leading-7 text-base-content/75">
          {platform.label} の掲載候補を確認中です。公開プロフィールが確認できたものだけを追加します。
        </div>
      )}
    </section>
  ))}
</section>

<script>
  type TwitterWidgets = {
    widgets?: {
      load: (element?: HTMLElement) => void;
    };
  };

  const twitterWindow = window as Window & typeof globalThis & { twttr?: TwitterWidgets };
  const socialTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-social-trigger]'));
  const socialPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-social-panel]'));

  const setActivePanel = (platform: string, options: { moveFocus?: boolean } = {}) => {
    socialTriggers.forEach((trigger) => {
      const active = trigger.dataset.platform === platform;
      trigger.classList.toggle('tab-active', active);
      trigger.setAttribute('aria-selected', String(active));
      trigger.setAttribute('tabindex', active ? '0' : '-1');
      if (active && options.moveFocus) {
        trigger.focus({ preventScroll: true });
      }
    });

    socialPanels.forEach((panel) => {
      panel.hidden = panel.id !== `${platform}-social-panel`;
    });
  };

  socialTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => setActivePanel(trigger.dataset.platform ?? 'x'));
    trigger.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) {
        return;
      }

      const currentIndex = socialTriggers.indexOf(trigger);
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        const next = socialTriggers[(currentIndex + 1) % socialTriggers.length];
        setActivePanel(next.dataset.platform ?? 'x', { moveFocus: true });
        return;
      }

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        const previous = socialTriggers[(currentIndex - 1 + socialTriggers.length) % socialTriggers.length];
        setActivePanel(previous.dataset.platform ?? 'x', { moveFocus: true });
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-social-load]').forEach((button) => {
    button.addEventListener('click', () => {
      const scriptUrl = button.dataset.script;
      const statusId = button.dataset.statusId;
      const targetId = button.dataset.targetId;
      const profileUrl = button.dataset.profileUrl;
      const displayName = button.dataset.displayName;
      const status = statusId ? document.getElementById(statusId) : null;
      const target = targetId ? document.getElementById(targetId) : null;

      if (!scriptUrl || !target || !profileUrl) {
        if (status) {
          status.textContent = '外部プロフィールをご利用ください。';
        }
        return;
      }

      if (!target.querySelector('a.twitter-timeline')) {
        const anchor = document.createElement('a');
        anchor.className = 'twitter-timeline';
        anchor.href = profileUrl;
        anchor.textContent = `${displayName ?? 'X'} のタイムライン`;
        target.replaceChildren(anchor);
      }

      if (document.querySelector(`[data-social-script="${scriptUrl}"]`)) {
        twitterWindow.twttr?.widgets?.load(target);
        if (status) {
          status.textContent = 'タイムラインの表示を更新しました。表示できない場合は外部プロフィールをご利用ください。';
        }
        return;
      }

      const script = document.createElement('script');
      script.src = scriptUrl;
      script.async = true;
      script.dataset.socialScript = scriptUrl;
      script.onload = () => {
        twitterWindow.twttr?.widgets?.load(target);
        if (status) {
          status.textContent = 'タイムラインを読み込みました。表示できない場合は外部プロフィールをご利用ください。';
        }
      };
      script.onerror = () => {
        if (status) {
          status.textContent = 'タイムラインの読み込みに失敗しました。外部プロフィールをご利用ください。';
        }
      };
      document.head.append(script);
      if (status) {
        status.textContent = 'タイムラインを読み込み中です。';
      }
    });
  });
</script>
