---
import { siteCopy } from '../lib/content';
---

<footer class="mt-16 border-t border-primary/30 bg-base-100 text-base-content">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-[2fr_1fr]">
      <div class="space-y-3">
        <h2 class="text-xl font-bold">{siteCopy.siteTitle}</h2>
        <p class="max-w-3xl text-sm leading-7 text-base-content/80">{siteCopy.unofficialDisclaimer}</p>
      </div>
      <nav aria-label="フッターナビゲーション" class="grid gap-2 text-sm">
        <a class="link link-hover text-primary" href="/about">このサイトについて</a>
        <a class="link link-hover text-primary" href="/operator">運営者について</a>
        <a class="link link-hover text-primary" href="/contact">お問い合わせ</a>
        <a class="link link-hover text-primary" href="/github">GitHub</a>
      </nav>
    </div>
  </div>
</footer>
