---
import { siteCopy } from '../lib/content';
---

<footer class="mt-16 bg-primary text-primary-content">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-[2fr_1fr]">
      <div class="space-y-3">
        <h2 class="text-xl font-bold">{siteCopy.siteTitle}</h2>
        <p class="max-w-3xl text-sm leading-7 text-primary-content/90">{siteCopy.unofficialDisclaimer}</p>
      </div>
      <nav aria-label="フッターナビゲーション" class="grid gap-2 text-sm">
        <a class="link link-hover" href="/about">このサイトについて</a>
        <a class="link link-hover" href="/operator">運営者について</a>
        <a class="link link-hover" href="/contact">お問い合わせ</a>
        <a class="link link-hover" href="https://github.com/mentamaru/mizuho-maru-un-official-fun-site" rel="noreferrer" target="_blank">GitHub</a>
      </nav>
    </div>
  </div>
</footer>
