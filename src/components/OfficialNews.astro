---
import type { OfficialItem } from '../lib/official';
import { formatDate } from '../lib/site-data';
import { toAbsoluteHttpUrl } from '../lib/url';

interface Props { items: OfficialItem[]; }
const { items } = Astro.props;
---

<section class="space-y-6" aria-labelledby="official-heading">
  <div class="space-y-2">
    <p class="text-sm font-semibold text-primary">瑞穂町公式RSS</p>
    <h2 id="official-heading" class="text-2xl font-bold text-base-content">公式情報</h2>
    <p class="leading-7 text-base-content/80">瑞穂町公式サイトのRSSから、みずほまるに関するお知らせを紹介しています。詳しい内容は元情報をご確認ください。</p>
  </div>

  <section aria-labelledby="official-latest-heading" class="space-y-4">
    <h3 id="official-latest-heading" class="text-xl font-bold text-base-content">最新情報</h3>
    {items.length > 0 ? <div class="news-grid">
      {items.map(item => <article class="news-article">{item.thumbnailUrl && <img data-official-thumbnail src={item.thumbnailUrl} alt="" loading="lazy" class="aspect-[1.91/1] w-full object-cover" />}<div class="news-body"><div class="flex flex-wrap items-center gap-2"><span class="badge badge-outline border-primary/30 text-primary">{item.category}</span><span class="text-sm text-base-content/70">{formatDate(item.publishedAt, item.collectedAt)}</span></div><h4 class="text-lg font-bold leading-7">{item.title}</h4><a class="news-source-link" href={toAbsoluteHttpUrl(item.originalUrl) ?? undefined} target="_blank" rel="noreferrer">元情報を見る</a></div></article>)}
    </div> : <p class="text-base-content/70">現在、掲載できる公式情報はありません。</p>}
  </section>

  <a class="btn btn-outline btn-primary" href="/official/">公式情報一覧を見る</a>
</section>
