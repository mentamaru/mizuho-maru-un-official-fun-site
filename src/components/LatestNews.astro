---
import { siteCopy } from '../lib/content';
import { formatDate, getSourceTypeLabel } from '../lib/site-data';
import { toAbsoluteHttpUrl } from '../lib/url';

import type { LatestItem } from '../lib/latest';
import { savedThumbnailUrl } from '../lib/ogp';

interface Props {
  items: LatestItem[];
}

const { items } = Astro.props;
const safeItems = items.map((item) => ({
  ...item,
  thumbnailUrl: savedThumbnailUrl(item.thumbnailUrl),
  safeOriginalUrl: toAbsoluteHttpUrl(item.originalUrl)
}));
---

<section class="space-y-6">
  <h2 class="text-2xl font-bold text-base-content">最新情報</h2>
  <p class="leading-7 text-base-content/80">みずほまるに関する公開情報から、最近の話題を紹介しています。詳しい内容は各元情報をご確認ください。</p>

  {safeItems.length > 0 ? <div class="grid gap-4 lg:grid-cols-3">
    {safeItems.map((item) => (
      <article class="card overflow-hidden border border-secondary/40 bg-base-100 shadow-sm">
        {item.thumbnailUrl && <img data-latest-thumbnail src={item.thumbnailUrl} alt="" loading="lazy" referrerpolicy="no-referrer" class="aspect-[1.91/1] w-full object-cover" />}
        <div class="card-body gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge badge-outline border-primary/30 text-primary">{getSourceTypeLabel(item.sourceType)}</span>
            {item.isRadar && <span class="badge badge-outline border-primary/30 text-primary">レーダー</span>}
            <span class="text-sm text-base-content/70">{formatDate(item.publishedAt, item.collectedAt)}</span>
          </div>
          <div class="space-y-2">
            <h3 class="text-lg font-bold leading-7 text-base-content">{item.title}</h3>
            <p class="text-sm text-base-content/70">{item.source} / {item.category}</p>
          </div>
          <p class="leading-7 text-base-content/80">{item.summary}</p>
          <div class="card-actions items-center justify-between gap-3">
            {item.safeOriginalUrl ? (
              <a class="btn btn-primary btn-sm" href={item.safeOriginalUrl} rel="noreferrer" target="_blank">{siteCopy.sourceLinkLabel}</a>
            ) : (
              <span class="text-sm text-base-content/80">元情報 URL を確認中です</span>
            )}
          </div>
        </div>
      </article>
    ))}
  </div> : <p class="text-base-content/70">現在、掲載できる最新情報はありません。</p>}
</section>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-latest-thumbnail]').forEach(image => {
    image.addEventListener('error', () => image.remove(), { once: true });
    if (image.complete && image.naturalWidth === 0) image.remove();
  });
</script>
