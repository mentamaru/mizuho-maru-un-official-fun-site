---
import Layout from '../layouts/Layout.astro';
import { siteCopy } from '../lib/content';
---

<Layout title="このサイトについて | 非公式みずほまる情報ポータル" description={siteCopy.siteDescription}>
  <article class="prose max-w-3xl rounded-3xl border border-secondary/40 bg-base-100 p-8 shadow-sm">
    <h1>このサイトについて</h1>
    <p>{siteCopy.siteDescription}</p>
    <p>みずほまるの最新情報を見つけやすくするために開発し、運営しています。</p>
    <p>個人運営・非営利です。</p>
  </article>
</Layout>
