---
import Layout from '../../layouts/Layout.astro';
import { loadRadarItems, radarMonth } from '../../lib/radar';
import { toAbsoluteHttpUrl } from '../../lib/url';
const items = loadRadarItems();
const months = [...new Set(items.map(item => radarMonth(item.discoveredAt)))];
---
<Layout title="みずほまるレーダー | 非公式みずほまる情報ポータル" description="みずほまるに関する新しい公開情報です。">
  <section class="space-y-6"><div class="space-y-2"><h1 class="text-3xl font-bold">みずほまるレーダー</h1><p class="leading-7 text-base-content/80">AIがWeb上を定期的に調査し、みずほまるに関する新しい話題を紹介しています。内容はAIによる要約です。正確な詳細は、各記事の元情報をご確認ください。</p></div>
  {items.length > 0 ? <><label class="form-control max-w-xs"><span class="label-text font-semibold">発見年月</span><select class="select select-bordered" data-radar-filter><option value="">すべて</option>{months.map(month => <option value={month}>{month.replace('-', '年')}月</option>)}</select></label><div class="news-list" data-radar-list>{items.map(item => <article class="news-article" data-radar-month={radarMonth(item.discoveredAt)}>{item.thumbnailUrl && <img data-radar-thumbnail src={item.thumbnailUrl} alt="" loading="lazy" class="aspect-[1.91/1] w-full object-cover" />}<div class="news-body"><div class="flex flex-wrap gap-2"><span class="badge badge-outline border-primary/30 text-primary">{item.category}</span><span class="text-sm text-base-content/70">{new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', month: 'numeric', day: 'numeric' }).format(new Date(item.discoveredAt))} 発見</span></div><h2 class="text-xl font-bold">{item.title}</h2>{item.date && <p class="text-sm">{item.dateType === 'event' ? '開催日' : item.dateType === 'sale' ? '発売日' : item.dateType === 'broadcast' ? '放送日' : '日付'}：{item.date}</p>}<p class="leading-7">{item.summary}</p><p class="text-sm text-base-content/70">主な情報元：<a class="link text-primary" href={toAbsoluteHttpUrl(item.source.url) ?? undefined} target="_blank" rel="noreferrer">{item.source.name}</a></p><details><summary class="cursor-pointer font-semibold">調査に利用した情報源</summary><ul class="mt-2 list-disc space-y-1 pl-5">{item.researchSources.map(source => <li><a class="link text-primary" href={toAbsoluteHttpUrl(source.url) ?? undefined} target="_blank" rel="noreferrer">{source.title}</a></li>)}</ul></details></div></article>)}</div></> : <p>現在、掲載できるレーダー情報はありません。</p>}</section>
</Layout>
<script>
  document.querySelector<HTMLSelectElement>('[data-radar-filter]')?.addEventListener('change', event => { const value = (event.currentTarget as HTMLSelectElement).value; document.querySelectorAll<HTMLElement>('[data-radar-month]').forEach(card => card.hidden = Boolean(value) && card.dataset.radarMonth !== value); });
</script>
